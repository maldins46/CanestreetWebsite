# Supabase — get these from your project dashboard at supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Only needed server-side (never expose in client code)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Canonical site URL — used for sitemap generation and Open Graph metadata
NEXT_PUBLIC_SITE_URL=https://canestreet.it

# Gmail — for sending registration and status change emails
# Enable 2FA on xxxxx@gmail.com, then generate an App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=xxxxx@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Set to true in local dev to suppress real email sending
DISABLE_EMAILS=false
NEXT_PUBLIC_CONTACT_EMAIL=xxxxx@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=+39 000 000 0000
